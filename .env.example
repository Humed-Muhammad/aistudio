# Humed’s AI Studio settings. Every key is optional: without keys everything runs free on this Mac.
# Use your own keys and never share a filled-in .env.

# Claude API: "Edit it for me", auto-planning, word checks and post text.
# Leave blank and ask Claude Code to plan by hand instead (uses your Claude plan, not this key).
ANTHROPIC_API_KEY=

# ElevenLabs: needed for Amharic transcripts (Scribe) and for "Strong" noise removal. Paid per minute.
ELEVENLABS_API_KEY=
# Transcription: elevenlabs, whisper (local, free, no Amharic) or auto (= elevenlabs when its key is set).
SHORTS_TRANSCRIBER=auto
SHORTS_SCRIBE_MODEL=scribe_v2
# Local whisper.cpp model: tiny, base, small, medium or large-v3-turbo.
SHORTS_WHISPER_MODEL=small
# Spoken language for new videos: am (Amharic, mixed with English is fine), en or auto.
# Avoid auto for mostly-Amharic speech: detection can pick English and skip every Amharic word.
SHORTS_LANGUAGE=am

# Chrome used for rendering. Blank = installed Google Chrome, else Remotion's bundled browser.
SHORTS_BROWSER=
# Person cutout: blank = best quality (ResNet-50, ~107 MB), fast = lighter MobileNet (15 MB).
SHORTS_MATTE=
# Longest accepted Shorts upload in seconds (600 = 10 minutes).
SHORTS_MAX_SECONDS=600
# Audio cleaner: longest accepted recording in seconds (3600 = 60 minutes).
CLEANER_MAX_SECONDS=3600

# Motion graphics: Claude Code CLI path if not found automatically, time limits, model for brief drafts.
# CLAUDE_BIN=
# GRAPHICS_BUILD_MINUTES=30
# GRAPHICS_CHANGE_MINUTES=15
# GRAPHICS_BRIEF_MODEL=sonnet
