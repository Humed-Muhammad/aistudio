# Obtain your own keys. Never share a populated .env.
# Seedance provider: enhancor or replicate. Blank = enhancor when ENHANCOR_API_KEY is set, otherwise replicate.
# Replicate runs Seedance 2.0 pay-per-use with REPLICATE_API_TOKEN only (no webhook, max 15s of reference video).
GENERATION_PROVIDER=
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=
# Shorts editor (optional). Automatic graphics planner; leave blank to plan with Claude Code instead.
ANTHROPIC_API_KEY=
# Transcription: elevenlabs (cloud, needed for Amharic), whisper (local) or auto (= elevenlabs when its key is set).
SHORTS_TRANSCRIBER=auto
ELEVENLABS_API_KEY=
SHORTS_SCRIBE_MODEL=scribe_v2
# Local whisper.cpp model (tiny, base, small, medium, large-v3-turbo). Whisper cannot transcribe Amharic reliably.
SHORTS_WHISPER_MODEL=small
# Default spoken language for new videos: am (Amharic with English words), en, or auto.
# Avoid auto for mostly-Amharic speech: detection can pick English and skip every Amharic word.
SHORTS_LANGUAGE=am
# Chrome used for rendering. Blank = installed Google Chrome, else Remotion's bundled browser.
SHORTS_BROWSER=
# Longest accepted clip in seconds (default 600 = 10 minutes).
SHORTS_MAX_SECONDS=600
