# Humed’s AI Studio settings. Every key is optional: without keys everything runs free on this Mac.
# Use your own keys and never share a filled-in .env.

# Claude API: "Edit it for me", auto-planning, word checks and post text.
# Leave blank and ask Claude Code to plan by hand instead (uses your Claude plan, not this key).
ANTHROPIC_API_KEY=

# ElevenLabs: needed for Amharic transcripts (Scribe) and for "Strong" noise removal. Paid per minute.
ELEVENLABS_API_KEY=
# Transcription: elevenlabs, whisper (local, free, no Amharic) or auto (= elevenlabs when its key is set).
SHORTS_TRANSCRIBER=auto
SHORTS_SCRIBE_MODEL=scribe_v2
# Local whisper.cpp model: tiny, base, small, medium or large-v3-turbo.
SHORTS_WHISPER_MODEL=small
# Spoken language for new videos: am (Amharic, mixed with English is fine), en or auto.
# Avoid auto for mostly-Amharic speech: detection can pick English and skip every Amharic word.
SHORTS_LANGUAGE=am

# Chrome used for rendering. Blank = installed Google Chrome, else Remotion's bundled browser.
SHORTS_BROWSER=
# Person cutout: blank = best quality (ResNet-50, ~107 MB), fast = lighter MobileNet (15 MB).
SHORTS_MATTE=
# Longest accepted Shorts upload in seconds (600 = 10 minutes).
SHORTS_MAX_SECONDS=600
# Longest accepted upload when tracking is off (screen recordings; 3600 = 60 minutes).
SHORTS_MAX_SECONDS_OFF=3600
# Audio cleaner: longest accepted recording in seconds (3600 = 60 minutes).
CLEANER_MAX_SECONDS=3600

# Motion graphics: Claude Code CLI path if not found automatically, time limits, model for brief drafts.
# CLAUDE_BIN=
# GRAPHICS_BUILD_MINUTES=30
# GRAPHICS_CHANGE_MINUTES=15
# GRAPHICS_BRIEF_MODEL=sonnet
# Graphics library: time limit for Claude Code making or changing one graphic (minutes).
# LIBRARY_MINUTES=15

# Channel (faceless YouTube videos). Every key is optional; each one turns on one step.
# YouTube Data API v3 key (free, 10,000 units a day): niche research reads. console.cloud.google.com > APIs > YouTube Data API v3 > Credentials.
YOUTUBE_API_KEY=
# Free stock footage for the visuals (pexels.com/api, pixabay.com/api/docs).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# fal.ai (paid per image / per second of AI video): AI images and a few AI clips, within each video's AI budget.
FAL_KEY=
# fal.ai models and prices (USD) used for estimates and the budget: change them when fal.ai changes.
# CHANNEL_FAL_IMAGE_MODEL=fal-ai/nano-banana
# CHANNEL_FAL_MASCOT_MODEL=fal-ai/nano-banana/edit
# CHANNEL_FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# CHANNEL_FAL_IMAGE_PRICE=0.04
# CHANNEL_FAL_VIDEO_PRICE=0.05
# Time limits for Claude Code (minutes): niche report, script, shot plan, chat message.
# CHANNEL_REPORT_MINUTES=20
# CHANNEL_SCRIPT_MINUTES=30
# CHANNEL_SHOTS_MINUTES=25
# CHANNEL_CHAT_MINUTES=10
# Uploads: save a Google OAuth client (Desktop app) as youtube-oauth.json in this folder, then Connect in Publish.
