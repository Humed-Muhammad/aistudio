# Obtain your own keys. Never share a populated .env.
# Seedance provider: enhancor or replicate. Blank = enhancor when ENHANCOR_API_KEY is set, otherwise replicate.
# Replicate runs Seedance 2.0 pay-per-use with REPLICATE_API_TOKEN only (no webhook, max 15s of reference video).
GENERATION_PROVIDER=
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=
